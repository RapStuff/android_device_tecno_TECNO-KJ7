on early-init
    write /sys/module/musb_hdrc/parameters/kernel_init_done 1

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 0

on fs
    wait /dev/block/platform/soc/11270000.ufshci
    symlink /dev/block/platform/soc/11270000.ufshci /dev/block/bootdevice
    write /sys/class/udc/musb-hdrc/device/cmode 2

on post-fs
    symlink /dev/block/by-name/lk1 /dev/block/by-name/bootloader1
    symlink /dev/block/by-name/lk2 /dev/block/by-name/bootloader2

    write /config/usb_gadget/g1/bcdDevice 0x0223
    write /config/usb_gadget/g1/bcdUSB 0x0200
    write /config/usb_gadget/g1/os_desc/use 1
    write /config/usb_gadget/g1/os_desc/b_vendor_code 0x1
    write /config/usb_gadget/g1/os_desc/qw_sign "MSFT100"
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500
    symlink /config/usb_gadget/g1/configs/b.1 /config/usb_gadget/g1/os_desc/b.1

on boot
    write /sys/class/udc/musb-hdrc/device/cmode 2
    setprop sys.usb.config none
    setprop sys.usb.state none

# recovery_main sets service.adb.root=1 even when sys.usb.config stays "none"
# (e.g. ro.debuggable=0 and ro.boot.verifiedbootstate != orange), leaving adbd
# holding /dev/usb-ffs/adb/ep0 and breaking minadbd sideload with -ESRCH.
on property:init.svc.adbd=running && property:sys.usb.config=none
    stop adbd

on property:init.svc.adbd=stopped
    setprop sys.usb.ffs.ready 0

on property:ro.adb.secure.recovery=0
    setprop sys.usb.config adb

on property:sys.usb.config=sideload
    stop adbd
