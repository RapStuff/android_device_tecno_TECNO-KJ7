# Transsion and MTK vendor service domains

type trancamserver, domain;
type trancamserver_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(trancamserver)
hwbinder_use(trancamserver)
add_hwservice(trancamserver, hal_trancamserver_hwservice)

type tran_hwinfo_binder, domain;
type tran_hwinfo_binder_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(tran_hwinfo_binder)
hwbinder_use(tran_hwinfo_binder)
add_hwservice(tran_hwinfo_binder, tran_hwinfo_binder_hwservice)

type hal_paytrigger, domain;
type hal_paytrigger_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_paytrigger)
hwbinder_use(hal_paytrigger)
add_hwservice(hal_paytrigger, hal_paytrigger_hwservice)

type hal_hap, domain;
type hal_hap_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_hap)
hwbinder_use(hal_hap)
add_hwservice(hal_hap, hal_hap_hwservice)

type tranradionet, domain;
type tranradionet_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(tranradionet)
vndbinder_use(tranradionet)
hwbinder_use(tranradionet)
add_hwservice(tranradionet, hal_trannet_hwservice)
allow tranradionet hal_trannet_service:service_manager add;

type chg_sence, domain;
type chg_sence_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(chg_sence)
allow chg_sence self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;

type get_ufs_error, domain;
type get_ufs_error_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(get_ufs_error)

type iomanager, domain;
type iomanager_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(iomanager)

type pnpmgr, domain;
type pnpmgr_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(pnpmgr)
vndbinder_use(pnpmgr)

type init_tran_mcf_sh, domain;
type init_tran_mcf_sh_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(init_tran_mcf_sh)
set_prop(init_tran_mcf_sh, vendor_tran_mcf_prop)

type tran_tinymix, domain;
type tran_tinymix_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(tran_tinymix)

type aeev, domain;
type aeev_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(aeev)

allow vendor_init mtk_radio_device:lnk_file unlink;

# Camera & Trancamserver IPC
allow mtk_hal_camera hal_trancamserver_hwservice:hwservice_manager find;
binder_call(mtk_hal_camera, trancamserver)
binder_call(trancamserver, mtk_hal_camera)
allow mtk_hal_camera trancamserver:fd use;
binder_call(system_server, trancamserver)
allow system_server hal_trancamserver_hwservice:hwservice_manager find;

# Camera Watermark
allow mtk_hal_camera vendor_watermark_data_file:dir rw_dir_perms;
allow mtk_hal_camera vendor_watermark_data_file:file create_file_perms;
get_prop(mtk_hal_camera, vendor_transsion_camera_watermark_support_prop)

# Camera Torch sysfs (prevents FORTIFY: fscanf: null FILE* crash in Hal3ARawImp::uninit)
allow mtk_hal_camera sysfs_torch_file:file rw_file_perms;
allow mtk_hal_camera sysfs_sub_torch_file:file rw_file_perms;

# Hwservicemanager prop reads for Transsion / MTK HAL daemons
get_prop(trancamserver, hwservicemanager_prop)
get_prop(tran_hwinfo_binder, hwservicemanager_prop)
get_prop(hal_paytrigger, hwservicemanager_prop)
get_prop(hal_hap, hwservicemanager_prop)

# Audio HAL
allow hal_audio_default hf_manager_device:chr_file rw_file_perms;
allow hal_audio_default sysfs_batteryinfo:dir search;

# Camera HAL & PQ HAL
set_prop(mtk_hal_camera, vendor_mtk_seninf_prop)
allow mtk_hal_camera sysfs:file r_file_perms;
dontaudit mtk_hal_camera shell_data_file:dir search;
dontaudit mtk_hal_camera default_prop:file read;
allow mtk_hal_pq mnt_vendor_file:dir search;
allow mtk_hal_pq sysfs:file r_file_perms;

# Health HAL
allow hal_health_default sysfs:file r_file_perms;

# Transsion & MTK daemons
dontaudit bip net_dns_prop:file r_file_perms;
dontaudit ccci_rpcd default_prop:file read;
allow chg_sence proc_bootconfig:file r_file_perms;
allow chg_sence proc_cmdline:file r_file_perms;
allow chg_sence sysfs_dt_firmware_android:dir search;
allow chg_sence gsi_metadata_file:dir search;
dontaudit get_ufs_error cache_file:dir search;
allow pnpmgr sysfs:file r_file_perms;
dontaudit pnpmgr sysfs:file write;
dontaudit pnpmgr property_socket:sock_file write;
allow smartcharging kmsg_device:chr_file getattr;
dontaudit stflashtool nfc_prop:file r_file_perms;
allow stflashtool sysfs_soc:dir search;
allow tran_tinymix audio_device:dir search;
allow tranradionet devpts:chr_file rw_file_perms;
binder_use(tranradionet)

# vendor_init permissions & expected denials
allow vendor_init proc_fingerprint_status:file w_file_perms;
allow vendor_init proc_gesture_function:file w_file_perms;
allow vendor_init conn_dbg_dev_device:file create_file_perms;
dontaudit vendor_init cache_file:dir { getattr search setattr };
dontaudit vendor_init vendor_userdir_file:dir { write add_name };
dontaudit vendor_init device:file create;
dontaudit vendor_init system_data_file:dir create;
dontaudit vendor_init default_prop:property_service set;
dontaudit vendor_init wifi_prop:property_service set;
