cc_library_static {
    name: "libperfmgr-ext-tecno_kj7",
    defaults: [
        "android.hardware.power-ndk_shared",
    ],
    vendor: true,
    srcs: [
        "power-mode.cpp",
    ],
    shared_libs: [
        "libbase",
        "liblog",
    ],
    cflags: [
        "-DTAP_TO_WAKE_NODE=\"/proc/gesture_function\"",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
